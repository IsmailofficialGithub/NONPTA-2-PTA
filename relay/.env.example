# WebSocket Server Port (Phone A connects here)
PORT=8080

# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here
DISCORD_TEXT_CHANNEL_ID=your_calls_channel_id_here
DISCORD_VOICE_CHANNEL_ID=your_active_call_voice_channel_id_here

# Telegram Configuration (Optional if Discord is used, or use both)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Audio Bridge Configuration (Linux PipeWire / PulseAudio Bluetooth HFP)
# Leave blank to use default system microphone/speaker or specify audio device names
AUDIO_SOURCE_DEVICE=default
AUDIO_SINK_DEVICE=default
