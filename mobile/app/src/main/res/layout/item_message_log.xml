<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_grouped_container"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row: Sender + SIM Badge + Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvMsgSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="UBL Digital"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvMsgSimBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="SIM 1 · Jazz"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/badge_sim_text"
            android:background="@drawable/bg_badge_sim" />

        <TextView
            android:id="@+id/tvMsgTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="21:05"
            android:textSize="11sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- Message Body -->
    <TextView
        android:id="@+id/tvMsgBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Your OTP for login is 839201"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:maxLines="4" />

    <!-- Footer Row: OTP Badge (Monospace, Tap to Copy) & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMsgOtpBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="OTP: 839201 · Copy"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/badge_otp_text"
            android:background="@drawable/bg_badge_otp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvMsgStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forwarded"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/status_active_text" />
    </LinearLayout>
</LinearLayout>
